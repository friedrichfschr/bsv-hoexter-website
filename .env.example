# Public URL used for canonical metadata, sitemap and robots.txt
# Use a complete absolute URL. Netlify deploy URLs are used automatically if this is invalid or unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local demonstration only. Keep false on an internet-facing deployment.
PREVIEW_FORMS_ENABLED=false
# Required for the protected editorial API and the /redaktion workspace.
EDITORIAL_API_KEY=
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For/X-Real-IP.
EDITORIAL_TRUSTED_PROXY=false
# Set true only when a trusted reverse proxy overwrites public-form client IP headers.
PUBLIC_FORMS_TRUSTED_PROXY=false
# Replace local disk with durable object/database storage before production.
EDITORIAL_CONTENT_DIRECTORY=.editorial-content
# Optional private BDK JSON/PDF directory; defaults below EDITORIAL_CONTENT_DIRECTORY.
BDK_DATA_DIRECTORY=.editorial-content/bdk
PREVIEW_SUBMISSIONS_DIR=.preview-submissions
